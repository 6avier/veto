# Copy to frontend/.env.local — gitignored.

# true  = run entirely on /contract fixtures, no backend needed
# false = talk to the real API through the Vite proxy
VITE_USE_MOCKS=true

# Leave unset in dev; the Vite proxy forwards /api to the Django server.
# Set to the deployed backend origin (e.g. https://veto-api.up.railway.app/api/v1) for prod builds.
# VITE_API_BASE_URL=

# Where the dev proxy forwards /api. Defaults to http://127.0.0.1:8000
# VITE_PROXY_TARGET=http://127.0.0.1:8000
