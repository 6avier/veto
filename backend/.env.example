# Copy to backend/.env — .env is gitignored, never commit real values.

# --- local development ---

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-only-insecure-do-not-use-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Leave unset for local SQLite. Set in deployed environments; dj_database_url
# parses it, so nothing in the code changes between SQLite and Postgres.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rule Studio only. The core dispatch loop never calls a model.
# When this is empty, extraction returns the honest "unavailable" fallback
# instead of reporting that the document contained no rules.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=

# --- deployed (Render) ---
#
# Set these in the dashboard, not here. Listed so the required set is visible.
#
#   DJANGO_DEBUG=False
#   DJANGO_SECRET_KEY=<generated; settings.py refuses to boot without one>
#   DJANGO_ALLOWED_HOSTS=veto-api.onrender.com
#   DATABASE_URL=<from the Render Postgres instance>
#   CORS_ALLOWED_ORIGINS=https://<project>.vercel.app
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://<project>.vercel.app
#   OPENAI_API_KEY=<real key>
#
# CORS matters in production in a way it never did locally: the Vite proxy made
# dev same-origin, but the deployed frontend and backend sit on different hosts.
# A missing Vercel origin here shows up as every request failing in the browser
# while curl against the API works.
#
# Uploaded PDFs live on the container's disk, which Render wipes on every deploy
# and every wake from sleep. Documents uploaded before a redeploy will not have
# a source page to render afterwards. Upload during the demo, not before it.
