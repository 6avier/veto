# Copy to backend/.env — .env is gitignored, never commit real values.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-only-insecure-do-not-use-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Leave unset for local SQLite. In deployed envs this is the Supabase pooler URL:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rule Studio only. The core dispatch loop never calls this.
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest.
GEMINI_MODEL=
